{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "paths": {
    "@skastr0/airlock": ["./packages/airlock/src/index.ts"],
    "@skastr0/airlock/testing": ["./packages/airlock/src/testing/index.ts"],
    "@skastr0/airlock-cloudflare": ["./packages/cloudflare/src/index.ts"],
    "@skastr0/airlock-cloudflare/alchemy": ["./packages/cloudflare/src/alchemy/index.ts"]
  },
  "include": ["packages/*/src", "packages/*/test", "test", "examples"]
}
