    "./alchemy": "./src/alchemy/index.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@skastr0/airlock": "0.1.0",
    "effect": "4.0.0-rc.115"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.79"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/airlock.git",
    "directory": "packages/cloudflare"
  },
  "homepage": "https://github.com/skastr0/airlock#readme",
