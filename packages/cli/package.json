{
  "name": "@skastr0/airlock-cli",
  "version": "0.1.0",
  "description": "The Airlock command pair: `airlock` for the person who decides, `airlock-agent` for the agent that may only run reviewed programs. Runs `.air` programs against the local filesystem host inside a native sandbox.",
