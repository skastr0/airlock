# State-preserving replacement composes Capture, Invoke, Apply, and a generic
# brokered remote-plan request. It has no Vouch or sandbox primitive.

let existing = file.inspect({ path: sandbox_inventory })

if existing.bytes > 0 {
  let snapshot = process.run({ executable: airlock_program, args: ["run", snapshot_program, "--sandbox", sandbox_name, "--archive", local_archive], cwd: workspace, stdin: "discard", stdout: "capture", stderr: "capture", timeoutMs: 300000, cellProfile: "compatibility" })
  assert snapshot.exit_code == 0, "replacement refused because snapshot failed"

  let saved = file.copy({ source: local_archive, destination: durable_backup })
  assert saved.state == "applied", "backup must enter managed state through Hold"

  let replacement = http.stage({ method: "POST", endpoint: realm_endpoint, holdMillis: 30000, body: "{\"action\":\"replace-machine\",\"name\":\"" + sandbox_name + "\",\"image\":\"" + image + "\"}" })
  assert replacement.state == "staged", "remote replacement must be staged before dispatch"

  let restore = process.run({ executable: airlock_program, args: ["run", restore_program, "--sandbox", sandbox_name, "--archive", durable_backup], cwd: workspace, stdin: "discard", stdout: "capture", stderr: "capture", timeoutMs: 300000, cellProfile: "compatibility" })
  assert restore.exit_code == 0, "replacement restore failed"
} else {
  let created = http.stage({ method: "POST", endpoint: realm_endpoint, holdMillis: 30000, body: "{\"action\":\"create-machine\",\"name\":\"" + sandbox_name + "\",\"image\":\"" + image + "\"}" })
  assert created.state == "staged", "initial create must be staged before dispatch"
}
