let built = process.run({ executable: make_executable, args: ["--no-print-directory", "verify"], descendantExecutables: ["/bin/sh", "/bin/bash", "/bin/mkdir", "/usr/bin/awk", "/bin/test", "/usr/bin/tr", "/usr/bin/printf"], cwd: workspace, env: { LANG: "C", LC_ALL: "C" }, stdin: "discard", stdout: "capture", stderr: "capture", timeoutMs: 30000, cellProfile: "native-contained" })
assert built.state == "succeeded", "project build check failed"

let report_path = workspace + "/build/export-count.txt"
let count = file.read({ path: report_path, format: "text" })
let report = file.inspect({ path: report_path })

return { built: built, count: count, report: report }
