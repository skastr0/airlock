# Triage the inbox: for every unread message from billing, read it, label it,
# and propose forwarding it to finance. Listing and reading run at once. The
# labels and the mail are only recorded; a supervisor decides whether they happen.
let inbox = mail.list({ mailbox: "inbox" })

for message in inbox.messages {
  if message.unread && message.from == "billing@example.com" {
    let full = mail.read({ id: message.id })
    label.add({ messageId: message.id, label: "billing" })
    mail.send({
      to: "finance@example.com",
      subject: "Fwd: " + full.subject,
      body: full.body
    })
  }
}

return { triaged: "inbox", seen: inbox.messages }
