#!/usr/bin/env bash
# Never trace the short-lived workload identity, even when invoked with bash -x.
set +x
set -euo pipefail

export PATH="${HOME}/.local/bin:${HOME}/.bun/bin:${PATH}"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

pinned_bun="$(sed -n 's/^[[:space:]]*"packageManager":[[:space:]]*"bun@\([^"]*\)".*/\1/p' package.json)"
command -v bun >/dev/null 2>&1 || {
  printf '[resume] Bun is unavailable; rerun .agents/setup\n' >&2
  exit 1
}
[[ "$(bun --version)" == "$pinned_bun" ]] || {
  printf '[resume] expected Bun %s; rerun .agents/setup\n' "$pinned_bun" >&2
  exit 1
}

locate_orb_setup() {
  local candidate
  for candidate in \
    "${repo_root}/../repos/orb-setup" \
    "${repo_root}/../repos/skastr0/orb-setup" \
    "${repo_root}/../orb-setup"; do
    if [[ -x "${candidate}/bin/resume.sh" ]]; then
      printf '%s' "$(cd "$candidate" && pwd)"
      return 0
    fi
  done
  return 1
}

orb_setup="$(locate_orb_setup)" || {
  printf '[resume] error: orb-setup checkout not found next to this repository\n' >&2
  exit 1
}
bash "${orb_setup}/bin/resume.sh"
