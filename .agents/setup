#!/usr/bin/env bash
# Amp orb setup: provision the pinned Bun toolchain, Linux native build
# prerequisites, and install dependencies.
#
# Runs once for a fresh orb (and again on stale snapshots, so it must be
# idempotent and fast on a warm filesystem). Workspace deps come from the
# lockfile. Tailscale and the published Quasar CLI are installed here;
# authentication happens in .agents/resume so credentials never enter a snapshot.
# Linux native-contained work needs libseccomp development files and an audited
# Bubblewrap 0.12.0 regular executable. This script never grants capabilities,
# installs a setuid helper, or changes AppArmor/sysctl policy.
set -euo pipefail

log() { printf '[setup] %s\n' "$*"; }

step() {
  local name="$1" start
  shift
  start="$(date +%s)"
  "$@"
  log "${name}: done in $(( $(date +%s) - start ))s"
}

# Resolve the toolchain pin from the repo's declared contract, not a hardcoded
# copy of it.
pinned_bun="$(sed -n 's/^[[:space:]]*"packageManager":[[:space:]]*"bun@\([^"]*\)".*/\1/p' package.json)"
if [ -z "$pinned_bun" ]; then
  log "ERROR: could not read the bun version from package.json packageManager"
  exit 1
fi
log "repo pins bun@$pinned_bun"

install_bun() {
  log "installing bun $pinned_bun"
  curl -fsSL https://bun.sh/install | bash -s "bun-v$pinned_bun" > /tmp/bun-install.log
  # The installer cannot update this running script's environment.
  export PATH="$HOME/.bun/bin:$PATH"
  hash -r
}

persist_bun_path() {
  # Persist for non-interactive login shells (Amp itself and supervised
  # services start in separate login shells after setup). When ~/.bash_profile
  # exists, bash reads it instead of ~/.profile, so cover both.
  local rc
  for rc in ~/.bashrc ~/.profile ~/.bash_profile; do
    if ! grep -Fqx 'export PATH="$HOME/.bun/bin:$PATH"' "$rc" 2>/dev/null; then
      printf '\nexport PATH="$HOME/.bun/bin:$PATH"\n' >> "$rc"
    fi
  done
}

persist_local_bin() {
  local rc
  for rc in ~/.bashrc ~/.profile ~/.bash_profile; do
    if ! grep -Fqx 'export PATH="$HOME/.local/bin:$PATH"' "$rc" 2>/dev/null; then
      printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
    fi
  done
}

ensure_bun() {
  local current=""
  current="$(bun --version 2>/dev/null || true)"
  if [ "$current" = "$pinned_bun" ]; then
    log "bun $pinned_bun already installed"
    return
  fi
  log "bun is ${current:-missing}; installing pinned $pinned_bun"
  install_bun
}

install_deps() {
  # Idempotent on a warm snapshot: bun confirms node_modules against the
  # lockfile and exits quickly when they match.
  bun install --frozen-lockfile
}

linux_native_packages=(
  build-essential
  libseccomp-dev
  libseccomp2
  pkg-config
  meson
  ninja-build
  libcap-dev
  libcap2-bin
  python3
  git
)

package_installed() {
  dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'
}

ensure_linux_native_packages() {
  if [ "$(uname -s)" != "Linux" ]; then
    log "skipping linux native packages on $(uname -s)"
    return
  fi
  local missing=() pkg
  for pkg in "${linux_native_packages[@]}"; do
    if ! package_installed "$pkg"; then
      missing+=("$pkg")
    fi
  done
  if [ "${#missing[@]}" -eq 0 ]; then
    log "linux native packages already installed"
    return
  fi
  log "installing linux native packages: ${missing[*]}"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "${missing[@]}"
}

airlock_getcap() {
  if command -v getcap >/dev/null 2>&1; then
    getcap "$@"
  elif [ -x /sbin/getcap ]; then
    /sbin/getcap "$@"
  elif [ -x /usr/sbin/getcap ]; then
    /usr/sbin/getcap "$@"
  else
    log "ERROR: getcap is required to verify Bubblewrap has no file capabilities"
    exit 1
  fi
}

audited_bwrap() {
  local dest="$1"
  local caps
  [ -x "$dest" ] || return 1
  [ ! -u "$dest" ] || return 1
  [ ! -g "$dest" ] || return 1
  [ "$("$dest" --version 2>/dev/null || true)" = "bubblewrap 0.12.0" ] || return 1
  caps="$(airlock_getcap "$dest" 2>/dev/null || true)"
  [ -z "$caps" ]
}

ensure_bubblewrap() {
  local dest="/usr/local/bin/bwrap"
  local pin="2a76602a8c71f36c1527cf9fc3417d9149822e0c"
  local src="/tmp/airlock-bubblewrap-0.12.0"
  if [ "$(uname -s)" != "Linux" ]; then
    log "skipping Bubblewrap on $(uname -s)"
    return
  fi
  if audited_bwrap "$dest"; then
    log "audited bubblewrap 0.12.0 already installed at $dest"
    return
  fi
  log "building audited Bubblewrap 0.12.0 ($pin)"
  rm -rf "$src"
  git clone --depth 1 --branch v0.12.0 \
    https://github.com/containers/bubblewrap.git "$src"
  if [ "$(git -C "$src" rev-parse HEAD)" != "$pin" ]; then
    log "ERROR: Bubblewrap HEAD is not the audited commit $pin"
    exit 1
  fi
  meson setup "$src/_build" "$src" -Dselinux=disabled -Dman=disabled -Dtests=false
  meson compile -C "$src/_build"
  sudo install -m 0755 "$src/_build/bwrap" "$dest"
  if [ -u "$dest" ] || [ -g "$dest" ]; then
    log "ERROR: refusing setuid/setgid Bubblewrap at $dest"
    exit 1
  fi
  if [ -n "$(airlock_getcap "$dest")" ]; then
    log "ERROR: refusing Bubblewrap with file capabilities at $dest"
    exit 1
  fi
  if [ "$("$dest" --version)" != "bubblewrap 0.12.0" ]; then
    log "ERROR: expected bubblewrap 0.12.0 at $dest"
    exit 1
  fi
  log "installed audited bubblewrap 0.12.0 at $dest"
}

install_tailscale() {
  # Install only: authentication belongs in resume, never in a shared snapshot.
  sudo install -d /etc/systemd/system/tailscaled.service.d
  sudo tee /etc/systemd/system/tailscaled.service.d/amp-orb.conf >/dev/null <<'EOF'
[Service]
Environment=TS_ASSUME_NETWORK_UP_FOR_TEST=true
EOF
  if command -v tailscale >/dev/null 2>&1; then
    log "Tailscale already installed"
  else
    log "installing Tailscale"
    curl -fsSL https://tailscale.com/install.sh | sh
  fi
  sudo systemctl daemon-reload
  # Starting an inactive daemon is safe; restarting an active one breaks reconnects.
  sudo systemctl enable --now tailscaled
}

install_quasar() {
  local quasar_version="0.5.3"
  local quasar_package="$HOME/.local/lib/node_modules/@skastr0/quasar-cli/package.json"
  local installed=""
  installed="$(node -p 'require(process.argv[1]).version' "$quasar_package" 2>/dev/null || true)"
  if [ -x "$HOME/.local/bin/quasar" ] && [ "$installed" = "$quasar_version" ]; then
    log "quasar-cli $quasar_version already installed"
    return
  fi
  log "installing @skastr0/quasar-cli@$quasar_version"
  npm install --global --prefix "$HOME/.local" "@skastr0/quasar-cli@$quasar_version"
}

export PATH="$HOME/.bun/bin:$PATH"
hash -r

step "bun toolchain" ensure_bun
persist_bun_path
installed="$(bun --version)"
if [ "$installed" != "$pinned_bun" ]; then
  log "ERROR: expected bun $pinned_bun, found $installed"
  exit 1
fi
log "bun $(command -v bun) ($installed)"

step "bun install" install_deps
step "linux native packages" ensure_linux_native_packages
step "audited bubblewrap" ensure_bubblewrap
step "tailscale" install_tailscale
step "quasar-cli" install_quasar
persist_local_bin
export PATH="$HOME/.local/bin:$PATH"
log "setup complete"
