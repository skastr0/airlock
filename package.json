{
  "name": "@skastr0/airlock",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "Optional tools for reviewed local changes, checked undo, staged external intent, and durable receipts alongside Bash and Python.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skastr0/airlock.git"
  },
  "homepage": "https://github.com/skastr0/airlock#readme",
  "bugs": {
    "url": "https://github.com/skastr0/airlock/issues"
  },
  "bin": {
    "airlock": "src/cli.ts",
    "airlock-agent": "src/agent-cli.ts"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "scripts/build-macos.ts",
    "scripts/build-linux.ts",
    "scripts/build-linux-launcher.sh",
    "scripts/build-box.ts",
    "scripts/seal-box.ts",
    "scripts/prove-sealed-box-macos.sh",
    "scripts/install-macos.sh",
    "scripts/uninstall-macos.sh",
    "scripts/install-linux.sh",
    "scripts/uninstall-linux.sh",
    "ARCHITECTURE.md",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build:macos": "bun scripts/build-macos.ts",
    "build:linux": "bun scripts/build-linux.ts",
    "build:linux-launcher": "sh scripts/build-linux-launcher.sh",
    "build:box": "bun scripts/build-box.ts",
    "seal:box": "bun scripts/seal-box.ts",
    "install:macos": "sh scripts/install-macos.sh",
    "uninstall:macos": "sh scripts/uninstall-macos.sh",
    "install:linux": "sh scripts/install-linux.sh",
    "uninstall:linux": "sh scripts/uninstall-linux.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts",
    "test:bun": "bun run scripts/verify-bun-integrations.ts",
    "verify": "bun run typecheck && bun run test && bun run test:bun"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
