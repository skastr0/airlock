{
 "name": "airlock",
 "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run ./packages/cli/src/cli.ts",
    "build:macos": "bun scripts/build-macos.ts",
    "build:linux": "bun scripts/build-linux.ts",
    "build:linux-launcher": "sh scripts/build-linux-launcher.sh",
    "build:box": "bun scripts/build-box.ts",
    "seal:box": "bun scripts/seal-box.ts",
    "install:macos": "sh scripts/install-macos.sh",
    "uninstall:macos": "sh scripts/uninstall-macos.sh",
    "install:linux": "sh scripts/install-linux.sh",
    "uninstall:linux": "sh scripts/uninstall-linux.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts",
    "test:bun": "bun run scripts/verify-bun-integrations.ts",
    "prove:core": "bun scripts/prove-core-portable.ts",
    "prove:cloudflare": "bun scripts/prove-cloudflare-portable.ts",
    "verify": "bun run typecheck && bun run test && bun run test:bun && bun run prove:core && bun run prove:cloudflare"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@skastr0/airlock": "workspace:*",
    "@skastr0/airlock-cli": "workspace:*",
    "@skastr0/airlock-cloudflare": "workspace:*",
    "@types/bun": "^1.4.2",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.115",
    "esbuild": "0.25.12",
    "miniflare": "4.20260708.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "license": "MIT"
}
