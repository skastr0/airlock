{
  "name": "@skastr0/airlock",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "An agent-only Unix runtime for structured plans, recoverable managed mutations, staged external intent, and durable receipts.",
  "bin": {
    "airlock": "src/cli.ts",
    "airlock-agent": "src/agent-cli.ts"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "scripts/build-macos.ts",
    "scripts/install-macos.sh",
    "scripts/uninstall-macos.sh",
    "ARCHITECTURE.md",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run ./src/cli.ts",
    "build:macos": "bun scripts/build-macos.ts",
    "install:macos": "sh scripts/install-macos.sh",
    "uninstall:macos": "sh scripts/uninstall-macos.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout 30000 --hookTimeout 30000",
    "test:bun": "bun run scripts/verify-bun-integrations.ts",
    "verify": "bun run typecheck && bun run test && bun run test:bun"
  },
  "dependencies": {
    "@effect/cli": "^0.75.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-bun": "^0.89.0",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
